# Port the API (and, in production, the built frontend) listens on.
PORT=3000
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
# Folder with the sample trades.csv and prices.csv (default: ../data).
# DATA_DIR=../data
# Built frontend served at / (default: ../frontend/dist; absent in development, where Vite serves it).
# STATIC_DIR=../frontend/dist
